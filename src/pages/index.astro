---
import Base from '../layouts/Base.astro';
import PixelIcon from '../components/PixelIcon.astro';
import DemoFrame from '../components/DemoFrame.astro';
import { abs, PILLARS, url, VERSION } from '../lib/docs';
import { elementDemo, elements, elementUrl, getElement } from '../lib/elements';

// 서버에서 정해 두는 결정적 난수 — 새로고침마다 레이아웃이 튀지 않게
const rand = (i: number, k: number) => {
  const x = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453;
  return x - Math.floor(x);
};

// 슬로건 자모와 같은 결의 흔들림 — 글자마다 진폭·주기·위상을 달리한다
const bob = (text: string, seed: number) =>
  [...text].map((c, i) => ({
    c,
    style: `--a:${(1 + rand(i, seed) * 1.5).toFixed(2)}px;--d:${(2 + rand(i, seed + 1) * 1.8).toFixed(2)}s;--dl:${(-rand(i, seed + 2) * 4).toFixed(2)}s`,
  }));

const floatStyle = (i: number, seed: number, amp = 2.5 + rand(i, seed) * 3) =>
  `--fa:${amp.toFixed(2)}px;--fd:${(3.4 + rand(i, seed + 1) * 2.4).toFixed(2)}s;--fdl:${(-rand(i, seed + 2) * 5).toFixed(2)}s`;

// 히어로 배경 — 드문드문 점멸하는 글리프 셀. 캔버스 없이 span 몇 개로만.
const GLYPHS = ['·', '·', '·', ':', '+', '·'];
const field = Array.from({ length: 64 }, (_, i) => {
  let x = rand(i, 11) * 100;
  const y = rand(i, 12) * 100;
  // 가운데 글자 영역은 비워 둔다
  if (y > 30 && y < 72 && x > 18 && x < 82) x = x < 50 ? x * 0.28 : 82 + (x - 50) * 0.36;
  return {
    g: GLYPHS[Math.floor(rand(i, 13) * GLYPHS.length)],
    style: `left:${x.toFixed(2)}%;top:${y.toFixed(2)}%;--tw:${(5 + rand(i, 14) * 4).toFixed(2)}s;--twd:${(-rand(i, 15) * 9).toFixed(2)}s`,
  };
});

// 홈에서 먼저 보여 줄 대표 요소 — 있는 것만
const PICKS = ['button', 'menu', 'switch', 'fx-fill', 'status-dot', 'modal', 'tab-bar', 'toast', 'text-field', 'segmented-control', 'progress-bar', 'badge'];
const picks = PICKS.map((id) => getElement(id)).filter((e) => !!e);

// 붙여넣는 짧은 지시문 — 전체 규칙은 /ai 와 요소 문서에 있다
const prompt = `이 프로젝트는 metaphr 디자인 시스템(${VERSION})을 따른다.
먼저 ${abs('/llms.txt')} 를 읽고, 요청에 맞는 요소 문서(/elements/<id>.md)만 골라 읽어 그 규칙대로 적용하라.
전역 CSS 맨 위: @import url("${abs(`/${VERSION}/tokens.css`)}"); @import url("${abs(`/${VERSION}/fonts.css`)}");
규칙이 요구사항과 충돌하면 임의로 정하지 말고 나에게 물어라.`;
---

<Base
  title="metaphr/design_lab"
  description="metaphr의 디자인 철학, 토큰, 폰트, 로고를 담은 참조 사이트. 사람과 AI가 같은 규칙을 읽습니다."
  width="list"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="field" aria-hidden="true">
      {field.map((f) => <span style={f.style}>{f.g}</span>)}
    </div>
    <h1 id="hero-title" class="slogan" aria-label="여백을 담습니다">
      {bob('여백을 담습니다', 1).map((ch) => (ch.c === ' ' ? <span aria-hidden="true">&nbsp;</span> : <span class="ch" style={ch.style} aria-hidden="true">{ch.c}</span>))}
    </h1>
    <p class="sub" aria-label="metaphr/design_lab">
      {bob('design_lab', 7).map((ch) => <span class="ch" style={ch.style} aria-hidden="true">{ch.c}</span>)}
    </p>
    <a class="scroll-hint" href="#elements" aria-label="아래로 스크롤">
      <span class="hint-mark" style={`--hint:url("${url('/v1/logos/down.svg')}")`}></span>
    </a>
  </section>

  <section id="elements" class="section elements reveal" aria-labelledby="el-title">
    <div class="section-head">
      <h2 id="el-title">요소</h2>
      <span>{elements.length}</span>
    </div>
    <ul class="picks" role="list">
      {picks.map((e) => (
        <li>
          <a class="pick" href={elementUrl(e!.id)}>
            <div class="shot">
              <DemoFrame html={elementDemo(e!).html} css={elementDemo(e!).css} title={`${e!.name} 예시`} />
            </div>
            <p>{e!.name}</p>
          </a>
        </li>
      ))}
    </ul>
    <div class="actions more">
      <a class="btn" href={url('/elements')}>요소 전체 보기 &gt;</a>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="pillars-title">
    <div class="section-head">
      <h2 id="pillars-title">세 기둥</h2>
      <span>minimalism · pixel art · retro color</span>
    </div>
    <ul class="cards" role="list">
      {PILLARS.map((p, i) => (
        <li class="card-float float" style={floatStyle(i, 41)}>
          <a class="card" href={`${url('/philosophy')}#${p.id}`}>
            <div class:list={['thumb', 'pillar-thumb', p.id]} aria-hidden="true">
              {p.id === 'minimalism' && <span class="pm-glyph">여백</span>}
              {p.id === 'pixel-art' && <PixelIcon src={url('/v1/icons/rhythm.png')} scale={3} />}
              {p.id === 'retro-color' && (
                <span class="retro-chips"><span class="rc paper" /><span class="rc slate" /><span class="rc teal" /><span class="rc orange" /></span>
              )}
            </div>
            <h3>{p.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section reveal read-col" aria-labelledby="ai-title">
    <div class="section-head">
      <h2 id="ai-title">AI 도구에서 시작하기</h2>
          </div>
    <pre id="prompt" hidden>{prompt}</pre>
    <div class="actions">
      <button type="button" class="btn" data-copy="prompt">지시문 복사</button>
      <a class="btn" href={url('/ai')}>AI 가이드 &gt;</a>
    </div>
  </section>
</Base>

<style>
  /* 목록 페이지는 머리 아래 여백을 히어로가 대신한다 */
  :global(main.page) { padding-top: 0; }

  /* ---------- 히어로 ---------- */

  .hero {
    position: relative;
    height: clamp(380px, calc(100svh - 15rem), 820px);
    margin: 0 calc(var(--mp-gutter) * -1);
  }

  .field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .field span {
    position: absolute;
    font-size: var(--mp-size-meta);
    line-height: 1;
    opacity: 0;
    animation: twinkle var(--tw) steps(1, end) var(--twd) infinite;
  }

  /* 켜진 채 오래, 꺼진 채 잠깐 — 셀 단위로 딱딱 */
  @keyframes twinkle {
    0%   { opacity: 0.22; }
    48%  { opacity: 0.3; }
    55%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* 움직임 줄이기 — 점멸 없이 정지 프레임 한 장 */
  @media (prefers-reduced-motion: reduce) {
    .field span { opacity: 0.22; }
  }

  .slogan {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: var(--mp-size-hero);
    letter-spacing: var(--mp-tracking-hero);
    white-space: nowrap;
    pointer-events: none;
  }

  .sub {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin: 0;
    padding-top: calc(var(--mp-size-hero) * 0.85);
    text-align: center;
    font-size: var(--mp-size-subheading);
    letter-spacing: 0.12em;
    opacity: var(--mp-opacity-brand);
  }

  .ch {
    display: inline-block;
    animation: bob var(--d) var(--mp-ease-float) var(--dl) infinite alternate;
  }

  @keyframes bob {
    from { transform: translateY(var(--a)); }
    to   { transform: translateY(calc(var(--a) * -1)); }
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 3rem);
    transform: translateX(-50%);
    padding: 0.4em 0.8em;
    opacity: 0.75;
    animation: hint 2.6s ease-in-out infinite;
  }
  .scroll-hint:hover { opacity: 1; }
  /* down.svg 의 모양만 빌려 글자색으로 — 라이트·다크 어디서나 보이게 */
  .hint-mark {
    display: block;
    width: clamp(16px, 2.2vw, 22px);
    aspect-ratio: 2 / 1;
    background: var(--mp-ink);
    -webkit-mask: var(--hint) center / 100% 100% no-repeat;
    mask: var(--hint) center / 100% 100% no-repeat;
  }

  @keyframes hint {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 5px); }
  }

  @media (max-width: 480px) {
    .slogan { font-size: var(--mp-size-heading); }
    .sub { padding-top: calc(var(--mp-size-heading) * 0.85); font-size: var(--mp-size-small); }
  }

  .elements { padding-top: var(--mp-section-lg); scroll-margin-top: 1rem; }

  /* ---------- 카드 — metaphr.dev 앱 카드 ---------- */

  .cards {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.9rem, 2.2vw, 1.5rem);
  }
  @media (max-width: 720px) {
    .cards { grid-template-columns: minmax(0, 1fr); }
  }

  .card-float { display: flex; min-width: 0; }
  .card-float:hover { animation-play-state: paused; }

  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    border: var(--mp-border) solid var(--mp-line);
    padding: clamp(1.2rem, 3vw, 1.7rem);
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .card:hover {
    border-color: var(--mp-line-strong);
    transform: translateY(-3px);
  }

  .card .thumb {
    aspect-ratio: 4 / 3;
    margin-bottom: clamp(0.9rem, 2vw, 1.2rem);
    font-size: var(--mp-size-title);
    letter-spacing: var(--mp-tracking-hero);
  }

  .card h3 {
    margin: 0;
    font-size: var(--mp-size-subheading);
    letter-spacing: var(--mp-tracking-subheading);
  }

  .card p {
    flex: 1;
    margin: 0 0 1.2em;
    font-size: var(--mp-size-body);
    line-height: var(--mp-leading-card);
    opacity: var(--mp-opacity-secondary);
  }

  /* ---------- 세 기둥 썸네일 ---------- */

  .pillar-thumb .pixel { width: var(--mp-pixel-card); height: var(--mp-pixel-card); }
  .pm-glyph { font-size: var(--mp-size-heading); letter-spacing: var(--mp-tracking-kicker); }

  /* 4색 견본 — teal과 orange는 붙이지 않고 한 칸(12px) 띄운다 */
  .retro-chips { display: flex; gap: 12px; }
  .rc { display: block; width: 36px; height: 36px; border: var(--mp-border) solid var(--mp-line); }
  .rc.paper { background: var(--mp-palette-paper); }
  .rc.slate { background: var(--mp-palette-slate); }
  .rc.teal { background: var(--mp-palette-teal); }
  /* 이 화면의 강조 한 곳 — orange는 면으로만 */
  .rc.orange { background: var(--mp-accent); }

  /* ---------- 지시문·자원 ---------- */

  .read-col > * { max-width: var(--mp-width-read); }
  .read-col pre { margin-bottom: 1.2em; }

  /* ---------- 요소 미리보기 — 썸네일 중심 ---------- */

  .picks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: clamp(0.9rem, 2.2vw, 1.5rem);
  }
  .picks li { display: flex; min-width: 0; }

  .pick {
    flex: 1;
    min-width: 0;
    border: var(--mp-border) solid var(--mp-line);
    text-decoration: none;
    transition: border-color var(--mp-duration-hover) ease;
  }
  .pick:hover,
  .pick:focus-visible { border-color: var(--mp-line-strong); }

  .pick .shot {
    aspect-ratio: 4 / 3;
    border-bottom: var(--mp-border) solid var(--mp-line);
    background: var(--mp-grid-bg);
    overflow: hidden;
  }

  .pick p {
    margin: 0;
    padding: 0.8em 1em;
    font-size: var(--mp-size-small);
    letter-spacing: var(--mp-tracking-small);
  }

  .more { margin-top: clamp(1.2rem, 3vh, 2rem); justify-content: center; }
</style>
