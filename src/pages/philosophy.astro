---
import Base from '../layouts/Base.astro';
import { Content, getHeadings } from '../content/philosophy.md';

// 문서가 길어져도 길을 잃지 않게 — h2는 목차, h3은 그 아래 작은 줄
const toc: { slug: string; text: string; subs: { slug: string; text: string }[] }[] = [];
for (const h of getHeadings()) {
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, subs: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].subs.push({ slug: h.slug, text: h.text });
}
---

<Base title="디자인 철학" description="여백을 담습니다 — 미니멀리즘 · 픽셀아트 · 레트로 컬러, 세 기둥과 해야 할 것/하지 말 것" slug="philosophy" width="list">
  <div class="doc">
    {toc.length > 1 && (
      <nav class="toc" aria-label="목차">
        <p class="toc-title">목차</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
              {h.subs.length > 0 && (
                <ol>
                  {h.subs.map((s) => <li><a href={`#${s.slug}`}>{s.text}</a></li>)}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="doc-body">
      <p class="kicker">philosophy · 세 기둥과 만드는 태도</p>
      <article class="prose"><Content /></article>
    </div>
  </div>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 clamp(2rem, 5vw, 4.5rem);
  }

  .doc-body { max-width: var(--mp-width-read); min-width: 0; }

  .toc {
    order: 0;
    margin-bottom: var(--mp-section);
    padding: 1.1em 0 0.4em;
    border-top: var(--mp-border) solid var(--mp-line);
    border-bottom: var(--mp-border) solid var(--mp-line);
    font-size: var(--mp-size-small);
    letter-spacing: var(--mp-tracking-small);
  }

  .toc-title {
    margin: 0 0 0.8em;
    font-size: var(--mp-size-kicker);
    letter-spacing: var(--mp-tracking-kicker);
    opacity: var(--mp-opacity-kicker);
  }

  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc > ol > li { margin-bottom: 0.7em; }
  .toc ol ol { display: none; margin-top: 0.35em; padding-left: 1em; }
  .toc ol ol li { margin-bottom: 0.25em; font-size: var(--mp-size-meta); letter-spacing: var(--mp-tracking-meta); line-height: 1.8; }

  .toc a {
    text-decoration: none;
    opacity: var(--mp-opacity-nav);
    transition: opacity var(--mp-duration-hover) ease;
  }
  .toc a:hover { opacity: 1; }

  /* 넓은 화면 — 왼쪽에 붙어 따라오는 목차, 본문은 읽기 폭 760px 그대로 */
  @media (min-width: 1100px) {
    .doc {
      grid-template-columns: minmax(0, 220px) minmax(0, var(--mp-width-read));
      justify-content: center;
    }
    .toc ol ol { display: block; }
    .toc {
      position: sticky;
      top: 2rem;
      align-self: start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      margin-bottom: 0;
      border-bottom: 0;
    }
  }

  .prose :global(h2),
  .prose :global(h3) { scroll-margin-top: 2rem; }
</style>
